# Proveedor global: ollama (local, sin costo por token) o kimi
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Para Kimi: cambia LLM_PROVIDER a kimi y agrega tu clave.
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

# Precios en USD por millón de tokens. Revisa los vigentes en la página de Moonshot.
# Si usas kimi y faltan, contrapeso_m1.py se niega a correr.
KIMI_PRECIO_ENTRADA_USD_M=
KIMI_PRECIO_SALIDA_USD_M=

# Opcional: un proveedor/modelo distinto por agente (diversidad de modelos, M4)
DIRECTOR_LLM_PROVIDER=kimi
DIRECTOR_MODELO=kimi-k3
INVESTIGADOR_LLM_PROVIDER=ollama
INVESTIGADOR_MODELO=llama3.2:3b
